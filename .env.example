# CryptoPulse v3.0 - Portfolio Release
# Keep mock mode for local development and public Vercel demos without AWS credentials.
VITE_BACKEND_MODE=mock

# Switch to api only when you have a deployed backend endpoint.
# VITE_BACKEND_MODE=api
# VITE_CRYPTO_BACKEND_URL=https://your-api-gateway-id.execute-api.us-east-1.amazonaws.com/prod

# Optional metadata shown in the cloud readiness panel.
VITE_CLOUD_PROVIDER=AWS
VITE_AUTH_PROVIDER=Cognito
VITE_DATABASE_PROVIDER=DynamoDB
VITE_FUNCTIONS_PROVIDER=Lambda
VITE_SCHEDULER_PROVIDER=EventBridge

# Optional public demo URL for documentation.
VITE_PUBLIC_DEMO_URL=https://cryptopulse-dashboard.vercel.app
